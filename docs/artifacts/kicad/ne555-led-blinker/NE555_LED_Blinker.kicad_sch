(text "NE555  /  LED BLINKER" (at 33.02 25.4 0) (effects (font (size 3 3) (bold yes)) (justify left)) (uuid "6c3f30ca-142b-46ba-877d-04b2ab09c6e4"))
(text "5 V DC   |   approx. 1 blink / second   |   through-hole parts" (at 33.02 34.29 0) (effects (font (size 1.65 1.65)) (justify left)) (uuid "5b72e466-3dec-4c36-908e-ba07ebeaa736"))
(text "01   POWER & BYPASS" (at 33.02 49.53 0) (effects (font (size 1.65 1.65) (bold yes)) (justify left)) (uuid "a8fa0b1b-e3a3-4a68-a95e-3e65a7e4e9b0"))
(text "02   ASTABLE TIMER" (at 120.65 49.53 0) (effects (font (size 1.65 1.65) (bold yes)) (justify left)) (uuid "7b633e9a-ed49-4243-96ce-43680e81e552"))
(text "03   INDICATOR" (at 215.9 49.53 0) (effects (font (size 1.65 1.65) (bold yes)) (justify left)) (uuid "0ce054f1-92ba-4c24-80a7-cd18f010153e"))
(text "C1: place close to U1 pins 8 / 1." (at 33.02 104.14 0) (effects (font (size 1.4 1.4)) (justify left)) (uuid "89058bdb-d047-4c00-9dc7-e3e69af0ac50"))
(text "Use a regulated, isolated 5 V source.\nJ1 pin 1 = +5 V; pin 2 = GND.\nObserve C2 / C3 and LED polarity." (at 33.02 115.57 0) (effects (font (size 1.4 1.4)) (justify left)) (uuid "9f0d50f9-4dd9-481c-846f-43bd4fc97bc0"))
(text "RESET held high.\nC4 filters control voltage." (at 109.22 135.89 0) (effects (font (size 1.4 1.4)) (justify left)) (uuid "8aa54be3-6846-4020-bcf0-6bb5b3c4f892"))
(text "LED is ON when OUT is HIGH." (at 215.9 125.73 0) (effects (font (size 1.3 1.3)) (justify left)) (uuid "068710fa-969c-47b3-a719-feb6219d6a07"))
(text "TIMING  |  calculated nominal values" (at 33.02 153.67 0) (effects (font (size 1.6 1.6) (bold yes)) (justify left)) (uuid "3ca7060c-9e90-4ece-b94b-cb857c52d058"))
(text "T = 0.693 x (R1 + 2 x R2) x C3 = 1.012 s     f = 0.988 Hz\nLED on: 0.541 s    /    off: 0.471 s    /    duty: 53.4%" (at 33.02 164.59 0) (effects (font (size 1.4 1.4)) (justify left)) (uuid "a6cabc6d-e6c9-4d63-b249-0d93274ac53d"))
(text "Timing varies with capacitor tolerance. Not physically tested.\nReference: Texas Instruments NE555 datasheet, astable operation." (at 33.02 179.07 0) (effects (font (size 1.25 1.25)) (justify left)) (uuid "b547830c-5ea8-47f5-bf53-ffd87db014ac"))
