{
  "name": "master",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "exclude": [],
      "include": [
        "~DEFAULT_BRANCH"
      ]
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "required_linear_history"
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Application tests",
            "integration_id": 15368
          },
          {
            "context": "PostgreSQL integration",
            "integration_id": 15368
          },
          {
            "context": "Android debug APK",
            "integration_id": 15368
          },
          {
            "context": "CI required",
            "integration_id": 15368
          },
          {
            "context": "Code rules",
            "integration_id": 15368
          },
          {
            "context": "Auto-format repository",
            "integration_id": 15368
          },
          {
            "context": "Trivy repository scan",
            "integration_id": 15368
          },
          {
            "context": "Zizmor GitHub Actions audit",
            "integration_id": 15368
          },
          {
            "context": "CodeQL (python)",
            "integration_id": 15368
          },
          {
            "context": "CodeQL (javascript-typescript)",
            "integration_id": 15368
          },
          {
            "context": "Offline startup and restart smoke",
            "integration_id": 15368
          },
          {
            "context": "Merge readiness snapshot",
            "integration_id": 15368
          }
        ]
      }
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "code_scanning",
      "parameters": {
        "code_scanning_tools": [
          {
            "tool": "CodeQL",
            "security_alerts_threshold": "high_or_higher",
            "alerts_threshold": "errors"
          }
        ]
      }
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "required_reviewers": [],
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": true,
        "require_extra_approval_for_unattributed_changes": true,
        "allowed_merge_methods": [
          "merge",
          "squash",
          "rebase"
        ]
      }
    }
  ]
}
