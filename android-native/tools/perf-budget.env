# Требования к производительности каждой стадии цепочки (мс, wall time на Redmi 9).
# Проверяются tools/bench.sh. Если стадия не укладывается, bench возвращает ошибку.
BUDGET_COMPILE_MS=800        # stages/compile.sh: clang, один исходник
BUDGET_LINK_MS=300           # stages/link.sh: aapt2 link, только манифест
BUDGET_SIGN_MS=900           # stages/sign.sh: подпись v1 (два прохода openssl cms)
BUDGET_ORCHESTRATOR_MS=60    # build-full.sh без работы стадий (кэш-решения)
BUDGET_FASTCHECK_MS=25       # build-native: проверка актуальности, когда APK свежий
BUDGET_SERVER_REQ_MS=2       # build-serverd: ответ на запрос build при готовом APK (внутри сервера)
