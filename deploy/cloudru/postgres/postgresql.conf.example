# PostgreSQL 17; стартовый профиль отдельного сервера с >=2 GiB RAM.
# Сохранить существующие data_directory/config_file/hba_file своего дистрибутива.
# За NAT bind IP — локальный адрес интерфейса, не обязательно публичный адрес.
listen_addresses = 'localhost,REPLACE_SERVER_BIND_IP'
port = 5432
max_connections = 60
superuser_reserved_connections = 3
shared_buffers = '256MB'
work_mem = '4MB'
maintenance_work_mem = '64MB'
password_encryption = 'scram-sha-256'
ssl = on
ssl_min_protocol_version = 'TLSv1.2'
ssl_cert_file = '/etc/postgresql/tls/server-fullchain.crt'
ssl_key_file = '/etc/postgresql/tls/server.key'
timezone = 'UTC'
fsync = on
full_page_writes = on
synchronous_commit = on
wal_level = replica
logging_collector = on
log_destination = 'jsonlog'
log_connections = on
log_disconnections = on
log_statement = 'none'
log_min_duration_statement = -1
log_min_error_statement = 'panic'
log_parameter_max_length_on_error = 0
# WAL/PITR archiving включать только после настройки и restore-теста архива.
# Архивная команда, возвращающая успех без сохранения WAL, недопустима.
