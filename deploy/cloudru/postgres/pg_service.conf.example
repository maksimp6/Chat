# Клиент backup/restore, права 0600. Пароль отдельно в PGPASSFILE (0600).
# Это libpq service file, не конфигурация EDS и не runtime DSN Алисы.
[alice-backup]
host=REPLACE_POSTGRES_FQDN
port=5432
dbname=alice
user=alice_backup
sslmode=verify-full
sslrootcert=/etc/ssl/certs/ca-certificates.crt
ssl_min_protocol_version=TLSv1.2
gssencmode=disable
channel_binding=require
connect_timeout=5
application_name=alice-backup
