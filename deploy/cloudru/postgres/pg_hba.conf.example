# Полный starter HBA отдельного PostgreSQL; порядок first-match.
# Существующий production HBA не заменять без проверки остальных клиентов.
local   all          postgres                              peer
local   all          all                                   reject
hostnossl all         all          0.0.0.0/0                 reject
hostnossl all         all          ::/0                      reject
hostssl alice        alice_app    REPLACE_APP_EGRESS_CIDR   scram-sha-256
# Добавить отдельную строку для каждого подтверждённого egress CIDR/семейства IP.
hostssl alice        alice_backup REPLACE_BACKUP_CIDR       scram-sha-256
host    all          all          0.0.0.0/0                 reject
host    all          all          ::/0                      reject
