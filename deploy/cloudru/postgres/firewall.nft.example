# Дополнительный guard TCP/5432 для Linux nftables; не заменяет основной firewall.
# Никакого flush ruleset. Пустые sets блокируют весь внешний доступ к PostgreSQL.
# Добавить подтверждённые application/backup CIDRs в соответствующие elements.
# Проверить через nft -c -f; согласовать с cloud firewall/NAT/container networking.
table inet alice_pg_guard {
    set allowed_v4 {
        type ipv4_addr
        flags interval
        # elements = { REPLACE_APP_EGRESS_CIDR, REPLACE_BACKUP_CIDR }
    }
    set allowed_v6 {
        type ipv6_addr
        flags interval
        # elements = { REPLACE_VERIFIED_IPV6_CIDR }
    }
    chain input {
        type filter hook input priority -5; policy accept;
        iifname "lo" tcp dport 5432 accept
        ip saddr @allowed_v4 tcp dport 5432 accept
        ip6 saddr @allowed_v6 tcp dport 5432 accept
        tcp dport 5432 drop
    }
}
