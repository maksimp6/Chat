  "components": {
    "x-cloud-backends": {
      "AliceContainer": {
        "name": "Alice_Container",
        "description": "Cloud.ru Container Apps resource; ID resolved by operator",
        "type": "serverless_container",
        "scheme": "http",
        "nodes": [
          {
            "container_id": "REPLACE_CONTAINER_APP_UUID",
            "weight": 1
          }
        ],
        "timeout": {
          "connect": 3,
          "send": 30,
          "read": 300
        }
      },
      "ChromeWorker": {
        "name": "Chrome_Worker",
        "description": "Private persistent Chrome Worker Container App; ID resolved by operator",
        "type": "serverless_container",
        "scheme": "http",
        "nodes": [
          {
            "container_id": "REPLACE_CHROME_WORKER_CONTAINER_APP_UUID",
            "weight": 1
          }
        ],
        "timeout": {
          "connect": 10,
          "send": 30,
          "read": 120
        }
      }
    },
    "securitySchemes": {
      "BrowserMachineAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Dedicated browser-worker bearer credential; never use an Alice session cookie."
      }
    }
  }
}
