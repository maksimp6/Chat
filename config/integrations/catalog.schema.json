{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alice.local/schema/integration-catalog-v1.json",
  "title": "Alice integration catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "as_of", "stale_after_days", "integrations"],
  "properties": {
    "schema_version": {"const": 1},
    "as_of": {"type": "string", "format": "date"},
    "stale_after_days": {"type": "integer", "minimum": 1},
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "name", "provider", "category", "status",
          "provider_exists", "alice_implemented", "e2e_verified",
          "last_verified", "issue", "official_source", "docs",
          "transports", "auth", "capabilities", "sandbox_available",
          "secret_store_required", "approval_required",
          "availability", "data_residency", "notes"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "name": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "status": {
            "enum": [
              "supported", "partial", "experimental", "planned",
              "research", "blocked", "deprecated", "unsupported"
            ]
          },
          "provider_exists": {"type": "boolean"},
          "alice_implemented": {"type": "boolean"},
          "e2e_verified": {"type": "boolean"},
          "last_verified": {"type": ["string", "null"], "format": "date"},
          "issue": {"type": "integer", "minimum": 1},
          "official_source": {"type": ["string", "null"]},
          "docs": {"type": "array", "items": {"type": "string"}},
          "transports": {"type": "array", "items": {"type": "string"}},
          "auth": {"type": "array", "items": {"type": "string"}},
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": ["read", "write", "events"],
            "properties": {
              "read": {"type": "boolean"},
              "write": {"type": "boolean"},
              "events": {"type": "boolean"}
            }
          },
          "sandbox_available": {"type": ["boolean", "null"]},
          "secret_store_required": {"type": "boolean"},
          "approval_required": {"type": "boolean"},
          "availability": {"type": ["string", "null"]},
          "data_residency": {"type": ["string", "null"]},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
