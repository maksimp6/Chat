{
  "name": "alice-pro-dev-tools",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "scripts": {
    "format": "bash scripts/format.sh write",
    "format:check": "bash scripts/format.sh check",
    "format:docs": "prettier --write \"docs/**/*.{md,json}\" \"README.md\" \".github/ISSUE_TEMPLATE/*.md\"",
    "format:docs:check": "prettier --check \"docs/**/*.{md,json}\" \"README.md\" \".github/ISSUE_TEMPLATE/*.md\""
  }
}
