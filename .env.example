# Local configuration template. Never put real credentials in this file.
YANDEX_API_KEY=<your-yandex-api-key>
YANDEX_PROJECT_ID=<your-yandex-project-id>
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1
CLOUDRU_BASE_URL=https://foundation-models.api.cloud.ru/v1

# Native durable database. Configure a persistent filesystem for deployment.
LOGOS_MEMORY_PATH=./logos.memory

HOST=0.0.0.0
PORT=8080
SECRET_KEY=<generate-a-random-secret>

# Global Yandex provider-key rotation (backend only)
LOGOS_PROVIDER_CREDENTIAL_KEY=<generate-a-fernet-key>
YANDEX_IAM_TOKEN=<server-side-iam-token>
YANDEX_SERVICE_ACCOUNT_ID=<service-account-id>
YANDEX_API_KEY_SCOPES=yc.ai.languageModels.execute,yc.ai.speechkitStt.execute,yc.ai.speechkitTts.execute
YANDEX_IAM_ENDPOINT=https://iam.api.cloud.yandex.net
YANDEX_PROVIDER_KEY_ID=<optional-yandex-provider-key-id-for-managed-rotation>

# Cloud.ru Foundation Models provider rotation
# Logos creates and manages the Foundation Models API key automatically.
# Cloud.ru allows key lifetimes from 1 day to 1 year; Logos defaults to daily rotation.
CLOUDRU_KEY_TTL_DAYS=1
# IAM credentials below are management credentials used only to reissue the Cloud.ru key.

# Per-user provider quotas. Set LOGOS_QUOTA_REQUIRE_IDENTITY=true for fail-closed identity enforcement.
# Defaults: 100 requests per 24h and 20 requests per minute. Use 0 to disable a limit.
LOGOS_QUOTA_PERIOD_SECONDS=86400
LOGOS_QUOTA_MAX_REQUESTS=100
LOGOS_QUOTA_MAX_REQUESTS_PER_MINUTE=20
LOGOS_QUOTA_REQUIRE_IDENTITY=false
# LOGOS_QUOTA_ADMIN_TOKEN=<long-random-admin-token>
# Administrative protection for provider credential configuration endpoints.
# When LOGOS_REQUIRE_SHORT_TOKEN=true, the existing short-token session is accepted instead.
# LOGOS_PROVIDER_CREDENTIALS_TOKEN=<long-random-admin-token>

# ChatGPT Apps SDK / MCP integration
LOGOS_MCP_ALLOW_ANONYMOUS=false
LOGOS_MCP_USER_ID=<stable-user-id>
LOGOS_MCP_BEARER_TOKEN=<development-bearer-token>
LOGOS_MCP_PUBLIC_URL=https://mcp.example.com
LOGOS_MCP_OAUTH_ISSUER=https://auth.example.com
LOGOS_MCP_OAUTH_SCOPE=logos.read
LOGOS_MCP_AUDIENCE=https://mcp.example.com/mcp
LOGOS_MCP_INTROSPECTION_URL=https://auth.example.com/oauth2/introspect
LOGOS_MCP_INTROSPECTION_CLIENT_ID=<oauth-client-id>
LOGOS_MCP_INTROSPECTION_CLIENT_SECRET=<oauth-client-secret>
LOGOS_MCP_INTROSPECTION_TIMEOUT=5
LOGOS_MCP_OAUTH_ISSUER=https://auth.example.com
LOGOS_MCP_OAUTH_SCOPE=logos.read
LOGOS_MCP_INTROSPECTION_URL=https://auth.example.com/oauth2/introspect
LOGOS_MCP_INTROSPECTION_CLIENT_ID=<introspection-client-id>
LOGOS_MCP_INTROSPECTION_CLIENT_SECRET=<introspection-client-secret>

# Cloud.ru IAM API-key management wizard (separate from Foundation Models runtime auth)
CLOUDRU_IAM_WIZARD_ENABLED=false
# Required for non-loopback deployments. Keep this server-side.
CLOUDRU_IAM_WIZARD_TOKEN=<long-random-admin-token>
CLOUDRU_IAM_ENDPOINT=https://iam.api.cloud.ru
CLOUDRU_IAM_KEY_ID=<service-account-key-id>
CLOUDRU_IAM_KEY_SECRET=<service-account-key-secret>

# Cloud.ru Local Tool Agent
# Bootstrap credential: only used during agent registration. Never use it as a runtime agent token.
LOGOS_LOCAL_AGENT_BOOTSTRAP_TOKEN=<long-random-secret>
# SSH Runtime
# Named remote targets. Do not place private keys in this variable; reference a server-side key file.
# Host keys are verified strictly against known_hosts.
LOGOS_SSH_TARGETS_JSON={"preview":{"host":"preview.example","port":22,"default_user":"logos-agent","allowed_users":["logos-agent"],"identity_map":{"<logos-owner-id>":"logos-agent"},"workspace_root":"/srv/logos","identity_file":"/srv/logos/keys/preview","known_hosts":"/srv/logos/ssh/known_hosts"}}
LOGOS_SSH_KNOWN_HOSTS=/srv/logos/ssh/known_hosts

# Optional donations entry point. Public http/https payment page only (e.g. a YooMoney
# fundraising page). Leave unset to hide the header button. Never put payment
# credentials, wallet secrets or notification secrets here.
# LOGOS_DONATION_URL=https://yoomoney.ru/fundraise/<public-fundraising-id>

# Energy-based compute billing. Only CPU time actually used by the request
# thread is measured (waiting on the model API is not billed):
#   energy_wh = cpu_seconds * LOGOS_CPU_WATTS_PER_CORE / 3600
# Watts per busy core defaults to 15. Without an electricity price the energy
# is recorded in the trace but not charged.
# LOGOS_CPU_WATTS_PER_CORE=15
# LOGOS_ELECTRICITY_PRICE_RUB_PER_KWH=6.5
