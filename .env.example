# Local configuration template. Never put real credentials in this file.
YANDEX_API_KEY=<your-yandex-api-key>
YANDEX_PROJECT_ID=<your-yandex-project-id>
YANDEX_BASE_URL=https://ai.api.cloud.yandex.net/v1

# Supabase / PostgreSQL read-only trace mirror configuration
SUPABASE_URL=https://<your-project-ref>.supabase.co
# Backend-only credential. Never expose it to the frontend or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
# Optional database URL for administrative/read-only diagnostics.
SUPABASE_DB_URL=postgresql://<user>:<password>@<host>:5432/postgres

HOST=0.0.0.0
PORT=8080
SECRET_KEY=<generate-a-random-secret>

# Global Yandex provider-key rotation (backend only)
ALICE_PROVIDER_CREDENTIAL_KEY=<generate-a-fernet-key>
YANDEX_IAM_TOKEN=<server-side-iam-token>
YANDEX_SERVICE_ACCOUNT_ID=<service-account-id>
YANDEX_API_KEY_SCOPES=yc.ai.languageModels.execute,yc.ai.speechkitStt.execute,yc.ai.speechkitTts.execute
YANDEX_IAM_ENDPOINT=https://iam.api.cloud.yandex.net

# ChatGPT Apps SDK / MCP integration
ALICE_MCP_ALLOW_ANONYMOUS=false
ALICE_MCP_USER_ID=<stable-user-id>
ALICE_MCP_BEARER_TOKEN=<development-bearer-token>
ALICE_MCP_PUBLIC_URL=https://mcp.example.com
ALICE_MCP_OAUTH_ISSUER=https://auth.example.com
ALICE_MCP_OAUTH_SCOPE=alice.read
ALICE_MCP_INTROSPECTION_URL=https://auth.example.com/oauth2/introspect
ALICE_MCP_INTROSPECTION_CLIENT_ID=<introspection-client-id>
ALICE_MCP_INTROSPECTION_CLIENT_SECRET=<introspection-client-secret>

# Cloud.ru IAM API-key wizard
CLOUDRU_IAM_WIZARD_ENABLED=false
# Required for non-loopback deployments. Keep this server-side.
CLOUDRU_IAM_WIZARD_TOKEN=<long-random-admin-token>
CLOUDRU_IAM_ENDPOINT=https://iam.api.cloud.ru
CLOUDRU_IAM_KEY_ID=<service-account-key-id>
CLOUDRU_IAM_KEY_SECRET=<service-account-key-secret>

# Cloud.ru Local Tool Agent
# Bootstrap credential: only used during agent registration. Never use it as a runtime agent token.
ALICE_LOCAL_AGENT_BOOTSTRAP_TOKEN=<long-random-secret>
