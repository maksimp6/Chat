<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.alice.pet">
<uses-sdk android:minSdkVersion="26" android:targetSdkVersion="25"/>
<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
<uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
<application android:label="Alice Pet" android:theme="@android:style/Theme.Translucent.NoTitleBar">
<activity android:name=".PetActivity" android:exported="true">
<intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
</activity>
<service android:name=".PetActivity$PetService" android:exported="false"/>
</application>
</manifest>